# Public site URL without a trailing slash, used for canonical URLs, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Quote form email (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional. Must be on a domain verified in Resend. Defaults to onboarding@resend.dev for testing.
RESEND_FROM_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
