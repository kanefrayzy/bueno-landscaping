# Runtime settings on the server: /opt/landscaping/.env (chmod 600).
# NEXT_PUBLIC_* values are compiled in at build time, see deploy/deploy.sh.

RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=

# Blog agent: bearer token for POST /api/blog/publish. Without it the route answers 404.
# Generate on the server: openssl rand -hex 32
BLOG_PUBLISH_TOKEN=
